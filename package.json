{
  "name": "snowy-path",
  "version": "1.0.0",
  "description": "Однопользовательская roadtrip-игра о зимнем путешествии и управлении ресурсами",
  "author": "AlexKazDrumm",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-project.js",
    "test": "node --test",
    "screenshot": "electron scripts/capture-screenshot.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.alexkazdrumm.snowypath",
    "productName": "SnowyPath",
    "artifactName": "SnowyPath-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "src/**/*",
      "styles/**/*",
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": ["nsis", "portable"],
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "SnowyPath-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "SnowyPath-Portable-${version}-${arch}.${ext}"
    }
  }
}
